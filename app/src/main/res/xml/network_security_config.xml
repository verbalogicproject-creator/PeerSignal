<?xml version="1.0" encoding="utf-8"?>
<!--
  The companion Python engine runs on the device itself (Termux) and is reached
  over plain HTTP on loopback: CompanionPythonEngineImpl targets
  http://127.0.0.1:8000.

  Cleartext is permitted for loopback ONLY. Every other destination keeps the
  platform default of HTTPS-required, so this does not weaken the app's posture
  for real network traffic the way android:usesCleartextTraffic="true" would.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
