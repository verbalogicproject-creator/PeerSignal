<?xml version="1.0" encoding="utf-8"?>
<!--
  ColdForge mark: an anvil under a signal arc, in the emerald accent already used
  across the app (EmeraldAccent = #50C878, theme/Color.kt:10).

  Drawn inside the inner 72x72dp of the 108x108dp adaptive canvas so nothing is
  clipped by round, squircle or circular masks.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- signal arcs -->
    <path
        android:strokeColor="#50C878"
        android:strokeWidth="3.2"
        android:strokeLineCap="round"
        android:fillColor="#00000000"
        android:pathData="M42,40 A 16,16 0 0 1 66,40" />
    <path
        android:strokeColor="#50C878"
        android:strokeWidth="3.2"
        android:strokeLineCap="round"
        android:strokeAlpha="0.55"
        android:fillColor="#00000000"
        android:pathData="M35,34 A 26,26 0 0 1 73,34" />

    <!-- anvil body -->
    <path
        android:fillColor="#50C878"
        android:pathData="M36,54 L72,54 L72,60 L66,60 C66,66 61,69 56,70 L56,74 L64,74 L64,80 L44,80 L44,74 L52,74 L52,70 C47,69 42,66 42,60 L36,60 Z" />

    <!-- spark -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M54,44 L57,50 L54,49 L51,50 Z" />
</vector>
